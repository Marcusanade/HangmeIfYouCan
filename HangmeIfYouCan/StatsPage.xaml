<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HangmeIfYouCan.StatsPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="White">

    <Grid RowDefinitions="Auto,*">

        <!-- Barra superior naranja -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto"
              BackgroundColor="#EA580C" Padding="12,10">
            <Button Grid.Column="0" Text="← Volver"
                    BackgroundColor="Transparent" TextColor="White"
                    FontSize="14" FontAttributes="Bold" Padding="0"
                    Clicked="OnBackClicked"/>
            <Label Grid.Column="1" Text="Estadísticas"
                   TextColor="White" FontSize="17" FontAttributes="Bold"
                   HorizontalOptions="Center" VerticalOptions="Center"/>
            <Button Grid.Column="2" x:Name="StatsMuteButton"
                    BackgroundColor="Transparent" TextColor="White"
                    FontSize="20" Padding="0" Margin="0,0,10,0"
                    Clicked="OnMuteClicked"/>
            <Button Grid.Column="3" Text="Resetear"
                    BackgroundColor="Transparent" TextColor="White"
                    FontSize="12" Padding="0"
                    Clicked="OnResetClicked"/>
        </Grid>

        <!-- Contenido scrollable -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="16" Padding="16,16,16,24">

                <!-- ── 1 JUGADOR ───────────────────────────────────── -->
                <Label Text="1 JUGADOR"
                       FontSize="12" FontAttributes="Bold"
                       TextColor="#9CA3AF" Margin="2,0"/>

                <!-- Rachas -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Border Grid.Column="0" BackgroundColor="#FFF7ED"
                            Stroke="#EA580C" StrokeThickness="2" Padding="12,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Racha actual" FontSize="11"
                                   TextColor="#9CA3AF" HorizontalOptions="Center"/>
                            <Label x:Name="CurrentStreakLabel"
                                   FontSize="28" FontAttributes="Bold"
                                   TextColor="#EA580C" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" BackgroundColor="#FFF7ED"
                            Stroke="#EA580C" StrokeThickness="2" Padding="12,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Mejor racha" FontSize="11"
                                   TextColor="#9CA3AF" HorizontalOptions="Center"/>
                            <Label x:Name="BestStreakLabel"
                                   FontSize="28" FontAttributes="Bold"
                                   TextColor="#EA580C" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Total global -->
                <Border BackgroundColor="#F9FAFB"
                        Stroke="#E5E7EB" StrokeThickness="1.5" Padding="14,12">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="*,*,*">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Jugadas" FontSize="11"
                                   TextColor="#9CA3AF" HorizontalOptions="Center"/>
                            <Label x:Name="TotalPlayedLabel"
                                   FontSize="24" FontAttributes="Bold"
                                   TextColor="#1C1917" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Ganadas" FontSize="11"
                                   TextColor="#9CA3AF" HorizontalOptions="Center"/>
                            <Label x:Name="TotalWonLabel"
                                   FontSize="24" FontAttributes="Bold"
                                   TextColor="#22C55E" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" Spacing="2">
                            <Label Text="% victorias" FontSize="11"
                                   TextColor="#9CA3AF" HorizontalOptions="Center"/>
                            <Label x:Name="TotalPctLabel"
                                   FontSize="24" FontAttributes="Bold"
                                   TextColor="#EA580C" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Por dificultad -->
                <Label Text="POR DIFICULTAD"
                       FontSize="12" FontAttributes="Bold"
                       TextColor="#9CA3AF" Margin="2,0"/>

                <Border BackgroundColor="#F0FDF4"
                        Stroke="#16A34A" StrokeThickness="1.5" Padding="14,12">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                        <Label Grid.Column="0" Text="Fácil" FontSize="14" FontAttributes="Bold"
                               TextColor="#16A34A" VerticalOptions="Center" WidthRequest="60"/>
                        <BoxView Grid.Column="1" x:Name="EasyBar" HeightRequest="8" CornerRadius="4"
                                 BackgroundColor="#16A34A" VerticalOptions="Center" Margin="8,0"/>
                        <Label Grid.Column="2" x:Name="EasyPlayedLabel" FontSize="13"
                               TextColor="#9CA3AF" VerticalOptions="Center" Margin="4,0"/>
                        <Label Grid.Column="3" Text=" · " TextColor="#D1D5DB" VerticalOptions="Center"/>
                        <Label Grid.Column="4" x:Name="EasyPctLabel" FontSize="13" FontAttributes="Bold"
                               TextColor="#16A34A" VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <Border BackgroundColor="#FFF7ED"
                        Stroke="#EA580C" StrokeThickness="1.5" Padding="14,12">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                        <Label Grid.Column="0" Text="Medio" FontSize="14" FontAttributes="Bold"
                               TextColor="#EA580C" VerticalOptions="Center" WidthRequest="60"/>
                        <BoxView Grid.Column="1" x:Name="MediumBar" HeightRequest="8" CornerRadius="4"
                                 BackgroundColor="#EA580C" VerticalOptions="Center" Margin="8,0"/>
                        <Label Grid.Column="2" x:Name="MediumPlayedLabel" FontSize="13"
                               TextColor="#9CA3AF" VerticalOptions="Center" Margin="4,0"/>
                        <Label Grid.Column="3" Text=" · " TextColor="#D1D5DB" VerticalOptions="Center"/>
                        <Label Grid.Column="4" x:Name="MediumPctLabel" FontSize="13" FontAttributes="Bold"
                               TextColor="#EA580C" VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <Border BackgroundColor="#FEF2F2"
                        Stroke="#DC2626" StrokeThickness="1.5" Padding="14,12">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                        <Label Grid.Column="0" Text="Difícil" FontSize="14" FontAttributes="Bold"
                               TextColor="#DC2626" VerticalOptions="Center" WidthRequest="60"/>
                        <BoxView Grid.Column="1" x:Name="HardBar" HeightRequest="8" CornerRadius="4"
                                 BackgroundColor="#DC2626" VerticalOptions="Center" Margin="8,0"/>
                        <Label Grid.Column="2" x:Name="HardPlayedLabel" FontSize="13"
                               TextColor="#9CA3AF" VerticalOptions="Center" Margin="4,0"/>
                        <Label Grid.Column="3" Text=" · " TextColor="#D1D5DB" VerticalOptions="Center"/>
                        <Label Grid.Column="4" x:Name="HardPctLabel" FontSize="13" FontAttributes="Bold"
                               TextColor="#DC2626" VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <!-- ── 2 JUGADORES ────────────────────────────────── -->
                <Label Text="2 JUGADORES"
                       FontSize="12" FontAttributes="Bold"
                       TextColor="#9CA3AF" Margin="2,8,2,0"/>

                <!-- Tabla de jugadores (generada dinámicamente en code-behind) -->
                <VerticalStackLayout x:Name="MultiplayerContainer" Spacing="8"/>

                <Label x:Name="NoMpStatsLabel"
                       Text="Aún no has jugado en modo 2 jugadores."
                       TextColor="#9CA3AF" FontSize="13"
                       HorizontalTextAlignment="Center"
                       IsVisible="False"/>

                <!-- Sin partidas en general -->
                <Label x:Name="NoStatsLabel"
                       Text="Aún no has jugado ninguna partida.&#10;¡Empieza a jugar para ver tus estadísticas!"
                       TextColor="#9CA3AF" FontSize="14"
                       HorizontalTextAlignment="Center"
                       IsVisible="False" Margin="0,12"/>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
